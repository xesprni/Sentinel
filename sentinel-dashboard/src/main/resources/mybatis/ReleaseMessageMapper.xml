<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alibaba.csp.sentinel.dashboard.repository.mapper.ReleaseMessageMapper">

    <resultMap id="BaseResultMap" type="com.alibaba.csp.sentinel.dashboard.datasource.entity.ReleaseMessageEntity">
        <id column="id" property="id"/>
        <result column="message" property="message"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.alibaba.csp.sentinel.dashboard.datasource.entity.ReleaseMessageEntity"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_release_message (message, update_time)
        VALUES (#{message}, #{updateTime})
    </insert>

    <select id="getLastReleaseIdByMessage" parameterType="string" resultType="java.lang.Long">
        SELECT MAX(id)
        FROM t_release_message
        WHERE message = #{message}
    </select>

    <select id="getFirst500ByIdDesc" resultMap="BaseResultMap">
        SELECT id, message, update_time
        FROM t_release_message
        WHERE id &gt; #{maxId}
        ORDER BY id ASC
        LIMIT 500
    </select>

    <select id="getMaxId" resultType="java.lang.Long">
        SELECT MAX(id)
        FROM t_release_message
    </select>

</mapper>
