<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alibaba.csp.sentinel.dashboard.repository.mapper.SystemRuleMapper">

    <resultMap id="BaseResultMap" type="com.alibaba.csp.sentinel.dashboard.datasource.entity.rule.SystemRuleEntity">
        <id column="id" property="id"/>
        <result column="app" property="app"/>
        <result column="ip" property="ip"/>
        <result column="port" property="port"/>
        <result column="highest_system_load" property="highestSystemLoad"/>
        <result column="avg_rt" property="avgRt"/>
        <result column="max_thread" property="maxThread"/>
        <result column="qps" property="qps"/>
        <result column="highest_cpu_usage" property="highestCpuUsage"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
    </resultMap>

    <delete id="deleteByApp">
        DELETE FROM sentinel_system_rule WHERE app = #{app}
    </delete>

    <insert id="insert" parameterType="com.alibaba.csp.sentinel.dashboard.datasource.entity.rule.SystemRuleEntity"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sentinel_system_rule (app, ip, port, highest_system_load, avg_rt, max_thread,
            qps, highest_cpu_usage, grade)
        VALUES (#{app}, #{ip}, #{port}, #{highestSystemLoad}, #{avgRt}, #{maxThread},
            #{qps}, #{highestCpuUsage}, 0)
    </insert>

    <select id="selectByApp" resultMap="BaseResultMap">
        SELECT * FROM sentinel_system_rule WHERE app = #{app}
    </select>

</mapper>
